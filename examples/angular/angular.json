{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "cli": {
        "analytics": false
    },
    "projects": {
        "angular": {
            "projectType": "application",
            "root": "",
            "sourceRoot": "src",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "browser": "src/main.ts",
                        "tsConfig": "tsconfig.json",
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "public"
                            },
                            {
                                "glob": "wasm/*.wasm",
                                "input": "node_modules/@docmentis/udoc-wasm/dist",
                                "output": "udoc-wasm"
                            },
                            {
                                "glob": "fonts/**/*",
                                "input": "node_modules/@docmentis/udoc-wasm/dist",
                                "output": "udoc-wasm"
                            }
                        ],
                        "styles": ["src/styles.css"]
                    }
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "options": {
                        "buildTarget": "angular:build"
                    }
                }
            }
        }
    }
}
