{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "verbatimModuleSyntax": true,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["svelte", "vite/client"]
    },
    "include": ["src/**/*.ts", "src/**/*.svelte"]
}
