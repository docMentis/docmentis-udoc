# Build output, and udoc-server's documents under `npm run dev` (target/udoc-data)
target
packages/*/dist
*.tsbuildinfo

# The docs site's API reference, generated by TypeDoc, and VitePress's cache
packages/udoc-docs/api/
packages/udoc-docs/.vitepress/cache/

# Node / npm workspace
node_modules

# Claude Code agent runtime state (scheduled-task locks, etc.), but not the
# repo's skills
.claude/*
!.claude/skills/

# Editor-local settings
.vscode/

# macOS Finder folder metadata
.DS_Store

# The examples' installs and builds (each is an app of its own, outside the
# workspaces, and installs from npm rather than a lockfile kept here)
examples/*/package-lock.json
examples/*/dist/
examples/*/out/
examples/*/.next/
examples/*/next-env.d.ts
examples/*/.nuxt/
examples/*/.output/
examples/*/.angular/
