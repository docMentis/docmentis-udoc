{
    "name": "@docmentis/udoc-node",
    "version": "0.8.8",
    "description": "Read, render, and process documents programmatically in Node.js.",
    "keywords": [
        "document",
        "pdf",
        "docx",
        "pptx",
        "xlsx",
        "word",
        "powerpoint",
        "excel",
        "office",
        "csv",
        "render",
        "png",
        "nodejs",
        "worker-threads",
        "docmentis",
        "udoc",
        "webassembly",
        "wasm"
    ],
    "homepage": "https://www.docmentis.com",
    "license": "MIT OR Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/docMentis/docmentis-udoc.git",
        "directory": "packages/udoc-node"
    },
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "LICENSE-MIT",
        "LICENSE-APACHE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "dev": "tsc -p tsconfig.json --watch",
        "build": "npm run clean && node scripts/check-version.mjs && tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
        "test": "node --test",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@docmentis/udoc-wasm": "0.8.12"
    }
}
