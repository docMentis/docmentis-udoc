{
    "name": "@docmentis/udoc-demo",
    "version": "0.8.2",
    "description": "A demo app showcasing the docMentis udoc-viewer and udoc-editor.",
    "keywords": [
        "demo",
        "document-viewer",
        "document-editor",
        "docmentis",
        "udoc"
    ],
    "homepage": "https://www.docmentis.com",
    "license": "MIT OR Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/docMentis/docmentis-udoc.git",
        "directory": "packages/udoc-demo"
    },
    "type": "module",
    "files": [
        "dist",
        "LICENSE-MIT",
        "LICENSE-APACHE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -p tsconfig.json --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "prepack": "node scripts/check-dist.mjs",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@docmentis/udoc-wasm": "0.8.4"
    },
    "devDependencies": {
        "@docmentis/udoc-editor": "*",
        "@docmentis/udoc-viewer": "*"
    }
}
