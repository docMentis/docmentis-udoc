{
    "name": "@docmentis/udoc-editor",
    "version": "0.8.3",
    "description": "Embeddable document editor with rich editing and real-time collaboration for the web.",
    "keywords": [
        "document-editor",
        "pdf-editor",
        "docx-editor",
        "pptx-editor",
        "xlsx-editor",
        "editor",
        "pdf",
        "docx",
        "pptx",
        "xlsx",
        "word",
        "powerpoint",
        "excel",
        "office",
        "collaboration",
        "real-time",
        "docmentis",
        "udoc",
        "webassembly",
        "wasm"
    ],
    "homepage": "https://www.docmentis.com",
    "license": "MIT OR Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/docMentis/docmentis-udoc.git",
        "directory": "packages/udoc-editor"
    },
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "LICENSE-MIT",
        "LICENSE-APACHE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "dev": "tsc -p tsconfig.json --watch",
        "build": "npm run clean && npm run compile",
        "compile": "node scripts/gen-version.mjs && tsc -p tsconfig.json && node scripts/bundle-workers.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
        "test": "node --test",
        "gen:icons": "node scripts/gen-icons.mjs",
        "gen:version": "node scripts/gen-version.mjs",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@docmentis/udoc-ui": "0.8.3",
        "@docmentis/udoc-wasm": "0.8.6"
    },
    "devDependencies": {
        "esbuild": "^0.25.12"
    }
}
