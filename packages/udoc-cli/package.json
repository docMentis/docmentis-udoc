{
    "name": "@docmentis/udoc-cli",
    "version": "0.8.0",
    "description": "Inspect, render, and export documents from the command line.",
    "keywords": [
        "cli",
        "command-line",
        "document",
        "pdf",
        "docx",
        "pptx",
        "xlsx",
        "word",
        "powerpoint",
        "excel",
        "office",
        "render",
        "png",
        "docmentis",
        "udoc",
        "webassembly",
        "wasm"
    ],
    "homepage": "https://www.docmentis.com/docs",
    "license": "MIT OR Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/docMentis/docmentis-udoc.git",
        "directory": "packages/udoc-cli"
    },
    "type": "module",
    "files": [
        "dist",
        "LICENSE-MIT",
        "LICENSE-APACHE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "bin": {
        "udoc": "dist/main.js"
    },
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "dev": "tsc -p tsconfig.json --watch",
        "build": "npm run clean && node scripts/check-version.mjs && tsc -p tsconfig.json && chmod +x dist/main.js",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
        "test": "node --test",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@docmentis/udoc-node": "0.8.0"
    }
}
