{
    "name": "@docmentis/udoc-ui",
    "version": "0.8.0",
    "description": "Shared document UI foundation for the docMentis viewer and editor.",
    "keywords": [
        "document-viewer",
        "document-editor",
        "docmentis",
        "udoc",
        "webassembly",
        "wasm"
    ],
    "homepage": "https://www.docmentis.com",
    "license": "MIT OR Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/docMentis/docmentis-udoc.git",
        "directory": "packages/udoc-ui"
    },
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "LICENSE-MIT",
        "LICENSE-APACHE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./internal": {
            "types": "./dist/internal.d.ts",
            "import": "./dist/internal.js"
        },
        "./worker": {
            "types": "./dist/worker/worker.d.ts",
            "import": "./dist/worker/worker.js"
        }
    },
    "scripts": {
        "dev": "tsc -p tsconfig.json --watch",
        "build": "npm run clean && npm run compile",
        "compile": "node scripts/gen-version.mjs && tsc -p tsconfig.json && node scripts/bundle-workers.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
        "test": "node --test",
        "gen:icons": "node scripts/gen-icons.mjs",
        "gen:version": "node scripts/gen-version.mjs",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@docmentis/udoc-wasm": "0.8.3"
    },
    "devDependencies": {
        "esbuild": "^0.25.12"
    }
}
