{
    "name": "@docmentis/udoc-viewer",
    "version": "0.8.0",
    "description": "Framework-agnostic document viewer over the docMentis engine.",
    "license": "MIT OR Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "CHANGELOG.md",
        "API-COMPARISON.md",
        "LICENSE-MIT",
        "LICENSE-APACHE"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "dev": "tsc -p tsconfig.json --watch",
        "build": "npm run clean && node scripts/gen-version.mjs && tsc -p tsconfig.json && node scripts/bundle-workers.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
        "test": "node --test",
        "gen:version": "node scripts/gen-version.mjs",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@docmentis/udoc-ui": "0.8.0"
    },
    "devDependencies": {
        "esbuild": "^0.25.12"
    }
}
