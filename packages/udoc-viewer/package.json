{
    "name": "@docmentis/udoc-viewer",
    "version": "0.8.0",
    "description": "Embeddable, high-fidelity document viewer for PDF, Word, PowerPoint, Excel, and more.",
    "keywords": [
        "document-viewer",
        "pdf-viewer",
        "docx-viewer",
        "pptx-viewer",
        "xlsx-viewer",
        "viewer",
        "pdf",
        "docx",
        "pptx",
        "xlsx",
        "word",
        "powerpoint",
        "excel",
        "office",
        "csv",
        "annotation",
        "docmentis",
        "udoc",
        "webassembly",
        "wasm"
    ],
    "homepage": "https://www.docmentis.com/docs",
    "license": "MIT OR Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/docMentis/docmentis-udoc.git",
        "directory": "packages/udoc-viewer"
    },
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "API-COMPARISON.md",
        "LICENSE-MIT",
        "LICENSE-APACHE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "dev": "tsc -p tsconfig.json --watch",
        "build": "npm run clean && npm run compile",
        "compile": "node scripts/gen-version.mjs && tsc -p tsconfig.json && node scripts/bundle-workers.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "gen:version": "node scripts/gen-version.mjs",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@docmentis/udoc-ui": "0.8.0"
    },
    "devDependencies": {
        "esbuild": "^0.25.12"
    }
}
