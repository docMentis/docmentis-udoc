{
    "$schema": "https://typedoc-plugin-markdown.org/schema.json",
    "tsconfig": "tsconfig.typedoc.json",
    // udoc-ui first: TypeDoc converts a symbol where it first meets it, and the
    // viewer and the editor re-export all of udoc-ui. The sidebar's order is
    // the plugin's.
    "entryPoints": [
        "../udoc-ui/dist/index.d.ts",
        "../udoc-viewer/dist/index.d.ts",
        "../udoc-editor/dist/index.d.ts",
        "../udoc-node/dist/index.d.ts",
        "../udoc-server/dist/index.d.ts"
    ],
    "sortEntryPoints": false,
    // Members as their declaration orders them, which groups related options
    // and methods together; statics first, so a class opens with `create`. The
    // plugin lists each package's exports alphabetically.
    "sort": ["static-first", "source-order"],
    "plugin": [
        "typedoc-plugin-markdown",
        "typedoc-vitepress-theme",
        "typedoc-plugin-missing-exports",
        "./scripts/typedoc-plugin.mjs"
    ],
    // The engine's types the API uses but doesn't export — its document model —
    // documented in the module that uses them, so every one in a signature
    // links somewhere (the plugin keeps only the engine's, and only what a
    // page links to). TypeScript's own libraries and Node's types stay out:
    // they are the only externals. (Not the default `**/node_modules/**`,
    // which in CI would take the engine with them.)
    "internalModule": "Engine types",
    "excludeExternals": true,
    "externalPattern": ["**/node_modules/typescript/**", "**/node_modules/@types/**"],
    "name": "API reference",
    "out": "api",
    "docsRoot": ".",
    "readme": "none",
    "excludeInternal": true,
    "excludePrivate": true,
    "excludeProtected": true,
    "disableSources": true,
    "excludeScopesInPaths": true,
    "hidePageHeader": true,
    // Pages to scan: a signature is one code block, and properties and
    // parameters are a table each, a row apiece, not a heading apiece. Where a
    // member comes from in udoc-ui's class hierarchy is nothing a reader acts
    // on, so tables leave out "Inherited from" and "Overrides", as the
    // plugin's theme does for members.
    "theme": "udoc",
    "useCodeBlocks": true,
    "indexFormat": "table",
    "parametersFormat": "table",
    "interfacePropertiesFormat": "table",
    "typeAliasPropertiesFormat": "table",
    "typeDeclarationFormat": "table",
    "tableColumnSettings": { "hideInherited": true, "hideOverrides": true },
    "validation": {
        "notExported": true,
        "invalidLink": true,
        "notDocumented": true
    }
}
