{
    "name": "@docmentis/udoc-docs",
    "version": "0.1.0",
    "description": "Developer guides and API documentation for the docMentis udoc ecosystem.",
    "license": "MIT OR Apache-2.0",
    "private": true,
    "type": "module",
    "scripts": {
        "api": "typedoc",
        "dev": "typedoc && vitepress dev",
        "build": "typedoc && vitepress build",
        "preview": "vitepress preview",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.snippets.json",
        "clean": "rm -rf dist api .vitepress/cache"
    },
    "dependencies": {
        "@docmentis/udoc-editor": "*",
        "@docmentis/udoc-node": "*",
        "@docmentis/udoc-server": "*",
        "@docmentis/udoc-ui": "*",
        "@docmentis/udoc-viewer": "*"
    },
    "devDependencies": {
        "@fontsource-variable/geist": "5.3.0",
        "@fontsource-variable/geist-mono": "5.3.0",
        "typedoc": "0.28.20",
        "typedoc-plugin-markdown": "4.13.1",
        "typedoc-plugin-missing-exports": "4.1.4",
        "typedoc-vitepress-theme": "1.1.4",
        "vitepress": "1.6.4"
    }
}
